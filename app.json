{
  "expo": {
    "name": "RentaFacil",
    "slug": "RentaFacil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gelsynest.RentaFacil"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#183A5C"
      },

      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.gelsynest.RentaFacil",
      "googleServicesFile": "./google-services.json",

      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAcOAr8EC6xLi6nFmYfOCK2wRvdFqwcxCc"
        }
      }
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "@react-native-community/datetimepicker",

      [
        "expo-image-picker",
        {
          "photosPermission": "RentaFacil necesita acceder a tus fotografías para adjuntarlas a las propiedades.",
          "cameraPermission": "RentaFacil necesita utilizar la cámara para tomar fotografías de las propiedades.",
          "microphonePermission": false
        }
      ],

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RentaFacil necesita tu ubicación para registrar la ubicación de las propiedades.",
          "locationAlwaysAndWhenInUsePermission": "RentaFacil necesita tu ubicación para registrar la ubicación de las propiedades.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],

      [
        "expo-calendar",
        {
          "calendarPermission": "RentaFacil necesita acceder al calendario para agregar recordatorios de contratos y pagos.",
          "remindersPermission": "RentaFacil necesita acceder a tus recordatorios."
        }
      ],

      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "defaultChannel": "rentafacil",
          "enableBackgroundRemoteNotifications": false
        }
      ],

      [
        "expo-camera",
        {
          "cameraPermission": "RentaFacil necesita utilizar la cámara para escanear el código QR de inicio de sesión.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],

      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "1ca20c8a-ebfe-4e6f-bc8f-43593270fddb"
      }
    }
  }
}